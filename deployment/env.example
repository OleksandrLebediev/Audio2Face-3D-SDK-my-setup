# Build configuration
BUILD_TYPE=release
SKIP_BUILD=0

# CUDA and TensorRT paths (inside container)
CUDA_PATH=/usr/local/cuda
TENSORRT_ROOT_DIR=/usr/lib/x86_64-linux-gnu

# Hugging Face token (get from https://huggingface.co/settings/tokens)
# Make sure to accept the license at https://huggingface.co/nvidia/Audio2Emotion-v2.2
HF_TOKEN=your_huggingface_token_here

# Startup options
DOWNLOAD_MODELS=1
RUN_UNIT_TESTS=0
BUILD_IN_CONTAINER=0

# Server settings
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

